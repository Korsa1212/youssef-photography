# Public site URL. Used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.youssefproduction.com

# Supabase (anon/publishable key only — never the service_role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Search Console verification token (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Full Google review link, e.g. https://search.google.com/local/writereview?placeid=ChIJ...
# Leave empty to hide the "Avis sur Google" button.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Wedding film shown on the homepage (click-to-play, zero performance cost).
# Accepts YouTube, Vimeo or a direct .mp4/.webm link.
# Facebook links cannot be embedded and are ignored, leaving the section hidden.
# Leave empty to hide the film section entirely.
#   -> put your link in .env.local (same variable name), then restart `npm run dev`
#   -> example: NEXT_PUBLIC_WEDDING_FILM_URL=https://www.youtube.com/watch?v=xxxxxxxxxxx
NEXT_PUBLIC_WEDDING_FILM_URL=

# Title shown above the film. Defaults to "Un film de mariage".
NEXT_PUBLIC_WEDDING_FILM_TITLE=

# Optional poster frame for the film. Falls back to the first portfolio photo.
NEXT_PUBLIC_WEDDING_FILM_POSTER=
